# Copie este arquivo para .env e preencha. NUNCA suba o .env para o GitHub.

# ---------- WhatsApp Cloud API (Meta) ----------
# Token permanente do Usuário do Sistema (Configurações do Negócio > Usuários do sistema)
WHATSAPP_TOKEN=
# "Identificação do número de telefone" (WhatsApp > Configuração da API)
WHATSAPP_PHONE_NUMBER_ID=
# Uma senha que VOCÊ inventa e repete na tela de Webhook da Meta
WHATSAPP_VERIFY_TOKEN=
# Chave secreta do app (Configurações do app > Básico). Obrigatória em produção.
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v23.0
# Endereço da API: Meta direto = https://graph.facebook.com | Dualhook = https://api.dualhook.com
WHATSAPP_API_BASE=https://graph.facebook.com
# ID da conta do WhatsApp (WABA). Opcional, mas recomendado com Dualhook.
WHATSAPP_WABA_ID=
# Caminho do webhook. Com Dualhook, use um caminho secreto, ex.: /webhook/a8f3k29xq7
WEBHOOK_PATH=/webhook

# ---------- Claude (Anthropic) ----------
ANTHROPIC_API_KEY=
# claude-sonnet-5-5 (melhor qualidade) ou claude-haiku-5-5 (mais barato)
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---------- Google Agenda ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gerado com: npm run google-auth
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# ---------- Regras da agenda ----------
TIMEZONE=America/Sao_Paulo
# 0=domingo, 1=segunda ... 6=sábado
WORK_DAYS=1,2,3,4,5
WORK_START=09:00
WORK_END=18:00
MEETING_DURATION_MIN=30
# Antecedência mínima para marcar (horas)
MIN_NOTICE_HOURS=2
# Até quantos dias à frente o cliente pode marcar
BOOKING_WINDOW_DAYS=14

# ---------- Equipe ----------
# Seu WhatsApp pessoal, só números com DDI e DDD (recebe alertas e pode usar #pausar / #retomar)
OWNER_WHATSAPP=
# Por quantas horas o robô fica quieto depois de passar o cliente para um humano
HANDOFF_HOURS=12
# Horas de silêncio com quem a AlphaTech chamou primeiro (prospecção) ou que respondeu com robô automático
OWNER_FIRST_PAUSE_HOURS=72

PORT=3000
